<section class="container books-page">
  <div class="page-heading">
    <div>
      <p class="eyebrow">Каталог</p>
      <h1>Книги</h1>
    </div>
    <form action="/books" method="get" class="search-form">
      <input type="search" name="title" value="<%= search %>" placeholder="Найти по названию">
      <button type="submit" class="button button-dark">Найти</button>
    </form>
  </div>

  <% if (books.length === 0) { %>
    <div class="empty-state">Книги не найдены.</div>
  <% } else { %>
    <div class="books-grid">
      <% books.forEach((book) => { %>
        <article class="book-card" data-book-id="<%= book.id %>">
          <div class="book-cover">
            <% if (book.image) { %>
              <img
                src="<%= book.image.startsWith('/') ? book.image : `/covers/${book.image}` %>"
                alt="Обложка: <%= book.title %>"
              >
            <% } else { %>
              <div class="book-cover-placeholder">BOOK</div>
            <% } %>
          </div>
          <div class="book-card-content">
            <span class="availability <%= book.is_active ? 'available' : 'unavailable' %>">
              <%= book.is_active ? "В наличии" : "Нет в наличии" %>
            </span>
            <h2><%= book.title %></h2>
            <div class="book-card-bottom">
              <strong><%= book.price %> ₴</strong>
              <div class="book-actions">
                <a href="/books/<%= book.id %>/edit" class="button button-outline">Изменить</a>
                <button type="button" class="button button-danger delete-book" data-id="<%= book.id %>">
                  Удалить
                </button>
              </div>
            </div>
          </div>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>

<script>
  document.querySelectorAll(".delete-book").forEach((button) => {
    button.addEventListener("click", async () => {
      if (!confirm("Удалить эту книгу из базы данных?")) return;

      button.disabled = true;
      try {
        const response = await fetch(`/books/${button.dataset.id}`, {
          method: "DELETE"
        });
        const result = await response.json();

        if (!response.ok) throw new Error(result.message || "Не удалось удалить книгу");
        button.closest(".book-card").remove();
      } catch (error) {
        alert(error.message);
        button.disabled = false;
      }
    });
  });
</script>
